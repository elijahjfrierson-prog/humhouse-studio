# Guard: plug-in windows stay exactly as in 1.5.3, when Analog Lab / ZENOLOGY / Surge XT opened full size:
# the HUMHOUSE VIEW frame only follows the plug-in's own size, and the window is never resized or rebuilt once shown.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../Source/EffectEditors.cpp" src)
# the only native resize allowed: pushing a collapsed (0-size) view out to its last good size
string(REGEX MATCHALL "native->setSize" ns "${src}")
string(FIND "${src}" "if (collapsed()" c1)   # also "if (collapsed() || shrank)": the one resize also restores a view that shrank back right after opening
string(FIND "${src}" "native->setSize (want.x, want.y);   // collapsed rescue" c2)
list(LENGTH ns nn)
if(NOT nn EQUAL 1 OR c1 LESS 0 OR c2 LESS c1)
    message(FATAL_ERROR "native->setSize is only allowed once, as the collapsed rescue")
endif()
foreach(bad "PluginFrame::resizable" "goodSizes" "repairs" "native->setVisible (true)")
    string(FIND "${src}" "${bad}" hit)
    if(NOT hit LESS 0)
        message(FATAL_ERROR "Plug-in window code must stay as in 1.5.3; found '${bad}' (this collapsed Analog Lab / ZENOLOGY)")
    endif()
endforeach()
string(REGEX MATCHALL "else ed = new PluginFrame \\(\\*plugin, ed\\);\n +EditorWindow::windows\\(\\)\\.add \\(new EditorWindow \\(" calls "${src}")
list(LENGTH calls n)
math(EXPR n "${n} / 2")   # each match holds one ";" so CMake splits it in two
if(NOT n EQUAL 2)
    message(FATAL_ERROR "Both plug-in editor windows (FX + instrument) must be: PluginFrame straight into a fixed-size EditorWindow (found ${n})")
endif()
string(FIND "${src}" "setResizable (resizable, false);" ctor)
string(FIND "${src}" "setVisible (true);\n        makeCaptureFriendly" vis)
if(ctor LESS 0 OR vis LESS 0 OR ctor GREATER vis)
    message(FATAL_ERROR "EditorWindow must set resizable before setVisible (true)")
endif()
foreach(f EffectEditors.cpp Playlist.cpp MixerView.cpp)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../Source/${f}" s)
    string(FIND "${s}" "setAlwaysOnTop (" hit)
    if(NOT hit LESS 0)
        message(FATAL_ERROR "${f}: use setOnTopSafely instead of setAlwaysOnTop on plug-in / floating windows")
    endif()
endforeach()
message(STATUS "plug-in window guard OK")
