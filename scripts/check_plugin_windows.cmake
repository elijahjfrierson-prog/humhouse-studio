# Guard: plug-in editor windows must never be made resizable (or rebuilt) after they are on screen.
# Doing so recreates the native window and VST3 views (Analog Lab, ZENOLOGY, Surge XT) collapse to an empty box.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../Source/EffectEditors.cpp" src)
string(REGEX MATCHALL "new EditorWindow \\([^;]*;[^\n]*\n[^\n]*setResizable" bad "${src}")
foreach(m IN LISTS bad)
    if(m MATCHES "PluginFrame")
        message(FATAL_ERROR "Plug-in EditorWindow made resizable after creation; pass PluginFrame::resizable (ed) to the constructor:\n${m}")
    endif()
endforeach()
string(FIND "${src}" "setResizable (resizable, false);" ctor)
string(FIND "${src}" "setVisible (true);\n        makeCaptureFriendly" vis)
if(ctor LESS 0 OR vis LESS 0 OR ctor GREATER vis)
    message(FATAL_ERROR "EditorWindow must set resizable before setVisible (true)")
endif()
string(FIND "${src}" "collapsed / not sized yet: keep a real window" keep)
if(keep LESS 0)
    message(FATAL_ERROR "PluginFrame::fit must never shrink the window to a collapsed plug-in view")
endif()
message(STATUS "plug-in window guard OK")
